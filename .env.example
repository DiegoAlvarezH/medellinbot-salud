# Copia este archivo como .env.local (ignorado por git) y completa los valores.

# OpenAI — requerido para el asistente con IA. Sin clave (o sin créditos) el chat
# funciona en "modo básico" con respuestas construidas solo con los datos abiertos.
OPENAI_API_KEY=
# Modelo de chat (opcional). Por defecto: gpt-5.5 (el más reciente). Para reducir costos: gpt-5.4-mini
OPENAI_MODEL=gpt-5.5
# Esfuerzo de razonamiento para modelos GPT-5: none | low | medium | high. Más alto = mejor pero más lento.
OPENAI_REASONING_EFFORT=low

# Límite de mensajes por minuto e IP en /api/chat (protege tu clave en producción).
CHAT_RATE_LIMIT_PER_MINUTE=15
